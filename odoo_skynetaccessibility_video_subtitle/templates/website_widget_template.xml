<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Injects the front-end Video Subtitle widget script on every public
        website page, just before </body>. The script URL is fixed here and is
        not configurable from the backend or System Parameters.
    -->
    <template id="website_widget_snippet"
              inherit_id="website.layout"
              name="Skynet Video Subtitle Widget">
        <xpath expr="//body" position="inside">
            <script id="aioa-adavs"
                    src="https://www.skynettechnologies.com/accessibility/js/video-subtitle/video-subtitle-widget.js"
                    defer="defer"/>
        </xpath>
    </template>

</odoo>
