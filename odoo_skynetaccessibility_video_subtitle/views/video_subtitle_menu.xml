<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Opens the dashboard inside the backend (client action in
        static/src/client/dashboard_action.js, URL
        /odoo/skynetaccessibility_video_subtitle_dashboard). A server action
        (not a controller) so the module needs no Python and still loads
        through Apps > Import Module. It only passes the signed-in user's
        name and email on as params. The API origin and platform are fixed in
        static/src/js/api.js, not stored in System Parameters.
    -->
    <record id="action_skynet_vs_dashboard" model="ir.actions.server">
        <field name="name">SkynetAccessibility Video Subtitle</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
login = user.login or ''
config = {
    'userName': user.name or '',
    'userEmail': user.email or user.partner_id.email or env.company.email or (login if '@' in login else ''),
}
action = {
    'type': 'ir.actions.client',
    'tag': 'skynetaccessibility_video_subtitle_dashboard',
    'name': 'SkynetAccessibility Video Subtitle',
    'params': {'config': config},
}
]]></field>
    </record>

    <menuitem id="menu_skynet_video_subtitle_root"
              name="SkynetAccessibility Video Subtitle"
              sequence="60"
              groups="base.group_system"/>

    <menuitem id="menu_skynet_video_subtitle_dashboard"
              name="Dashboard"
              parent="menu_skynet_video_subtitle_root"
              action="action_skynet_vs_dashboard"
              sequence="10"/>


</odoo>
