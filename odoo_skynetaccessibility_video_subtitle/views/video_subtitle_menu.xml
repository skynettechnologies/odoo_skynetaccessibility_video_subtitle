<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        No custom model/fields are defined (Import Module does not load
        Python), so this settings screen edits the two
        ir.config_parameter rows this module ships directly - key/value
        are stock fields on that model. The list view below just gives
        them friendlier labels than the generic System Parameters grid.
    -->
    <record id="view_skynet_vs_config_param_list" model="ir.ui.view">
        <field name="name">skynet.video.subtitle.config.param.list</field>
        <field name="model">ir.config_parameter</field>
        <field name="arch" type="xml">
            <tree string="SkynetAccessibility Video Subtitle Settings" editable="bottom">
                <field name="key" readonly="1" string="Setting"/>
                <field name="value" string="Value"/>
            </tree>
        </field>
    </record>

    <record id="view_skynet_vs_config_param_form" model="ir.ui.view">
        <field name="name">skynet.video.subtitle.config.param.form</field>
        <field name="model">ir.config_parameter</field>
        <field name="arch" type="xml">
            <form string="SkynetAccessibility Video Subtitle Settings">
                <sheet>
                    <group>
                        <field name="key" readonly="1" string="Setting"/>
                        <field name="value" string="Value"/>
                    </group>
                    <div class="text-muted" style="margin-top: 8px;">
                        enable_widget: True or False. widget_script: full script URL.
                        api_base: Skynet API base URL. platform: sent to the API as-is.
                        manage_by_platform: 1 or 0.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_skynet_vs_config_param" model="ir.actions.act_window">
        <field name="name">SkynetAccessibility Video Subtitle Settings</field>
        <field name="res_model">ir.config_parameter</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('key', 'in', [
            'skynet_video_subtitle.enable_widget',
            'skynet_video_subtitle.widget_script',
            'skynet_video_subtitle.api_base',
            'skynet_video_subtitle.platform',
            'skynet_video_subtitle.manage_by_platform',
        ])]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <menuitem id="menu_skynet_video_subtitle_root"
              name="SkynetAccessibility Video Subtitle"
              sequence="60"
              groups="base.group_system"/>

    <menuitem id="menu_skynet_video_subtitle_dashboard"
              name="Dashboard"
              parent="menu_skynet_video_subtitle_root"
              action="action_skynet_vs_dashboard_url"
              sequence="10"/>

    <menuitem id="menu_skynet_video_subtitle_settings"
              name="Configuration"
              parent="menu_skynet_video_subtitle_root"
              action="action_skynet_vs_config_param"
              sequence="20"/>

</odoo>
