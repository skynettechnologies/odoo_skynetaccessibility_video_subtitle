<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Phase 2 dashboard: full scan / remediate / multi-language workflow,
        ported from the django_skynetaccessibility_videosubtitle reference
        package's templates/skynet_video_subtitle/dashboard.html,
        static/skynet_video_subtitle/js/{api,app}.js and
        static/skynet_video_subtitle/css/video-remediation.css. Those three
        front-end files are framework-agnostic (no Django template syntax,
        no server endpoints of their own - every request goes straight from
        the browser to the Skynet Video Subtitle API), so they are carried
        over as static/src/{js,css}/vs-dashboard-*, with only two changes:

          1. vs-dashboard-api.js reads SITE_ORIGIN/PLATFORM from
             window.SkynetVideoSubtitleConfig (built below from this
             module's own ir.config_parameter rows) instead of the
             reference's hardcoded values, and passes the logged-in
             Settings user's name/email into VideoApi.getStart() instead of
             the reference's "no-reply@<domain>" fallback.
          2. This page's markup is the reference's dashboard.html with
             Django's {% %}/{{ }} template tags replaced by the equivalent
             QWeb, and made XML-well-formed (self-closed void elements,
             quoted boolean attributes, escaped "&", no doubled hyphens inside
             comments) since QWeb parses this as XML rather than HTML.

        Every element id in the markup below matches vs-dashboard-app.js's
        cacheElements() exactly, so that file is unmodified from the
        reference. Registration (video-subtitle/get-start) happens
        entirely client-side and only when needed - see the "Phase 2"
        notes in vs-dashboard-api.js - so, unlike the old Phase 1 page,
        there is no separate registration bootstrap script here: the
        config-bootstrap script below only fills in
        window.SkynetVideoSubtitleConfig, nothing more.

        Access is restricted with groups_id on the view itself, so only
        Settings/Administration users (base.group_system) can open it.
    -->
    <record id="view_skynet_vs_dashboard_page" model="ir.ui.view">
        <field name="name">skynet.video.subtitle.dashboard.page</field>
        <field name="type">qweb</field>
        <field name="key">odoo_skynetaccessibility_video_subtitle.dashboard_page</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="arch" type="xml">
            <t t-name="odoo_skynetaccessibility_video_subtitle.dashboard_page">
                <t t-set="skynet_vs_api_base"
                   t-value="request.env['ir.config_parameter'].sudo().get_param('skynet_video_subtitle.api_base', 'https://ada.skynettechnologies.us/api/')"/>
                <t t-set="skynet_vs_platform"
                   t-value="request.env['ir.config_parameter'].sudo().get_param('skynet_video_subtitle.platform', 'Odoo')"/>

                <!--
                    Registration user data (name/email) sent to the Skynet
                    "get-start" API by vs-dashboard-api.js's getStart(),
                    via window.SkynetVideoSubtitleConfig below. Prefer the
                    currently logged-in user (this page is already
                    restricted to base.group_system, so that's an
                    admin/Settings user in practice). If that user has no
                    email/login set for some reason, fall back to Odoo's
                    default admin user, then finally to the company's own
                    email.
                -->
                <t t-set="skynet_vs_fallback_admin"
                   t-value="request.env.ref('base.user_admin', raise_if_not_found=False)"/>
                <t t-set="skynet_vs_reg_user"
                   t-value="request.env.user if (request.env.user.email or request.env.user.login) else (skynet_vs_fallback_admin or request.env.user)"/>
                <t t-set="skynet_vs_username" t-value="skynet_vs_reg_user.name or 'Odoo Admin'"/>
                <t t-set="skynet_vs_useremail"
                   t-value="skynet_vs_reg_user.email or skynet_vs_reg_user.login or request.env.company.email or ''"/>

                <!--
                    Where the header's "Back" link should point. Mirrors
                    the reference _resolve_back_url(): prefer the page the
                    user actually came from, but only trust Referer when
                    it points back at this same host (it is
                    client-supplied and could otherwise steer the link at
                    an arbitrary external URL); otherwise fall back to the
                    Odoo backend.
                -->
                <t t-set="skynet_vs_referrer" t-value="request.httprequest.referrer"/>
                <t t-set="skynet_vs_back_url"
                   t-value="skynet_vs_referrer if (skynet_vs_referrer and skynet_vs_referrer.startswith(request.httprequest.host_url)) else '/odoo'"/>

                <html lang="en" data-bs-theme="light">
                <head>
                  <meta charset="utf-8" />
                  <meta name="viewport" content="width=device-width, initial-scale=1" />
                  <title>SkynetAccessibility Video Subtitle</title>

                  <!-- Bootstrap 5.3 -->
                  <link
                    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
                    rel="stylesheet"
                    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
                    crossorigin="anonymous" />

                  <!-- Material Symbols (icon font used by the React component) -->
                  <link rel="preconnect" href="https://fonts.googleapis.com" />
                  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                  <link
                    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"
                    rel="stylesheet" />

                  <link rel="stylesheet" href="/odoo_skynetaccessibility_video_subtitle/static/src/css/vs-dashboard.css"/>

 
                </head>

                <body>
                  <div class="aioa_dashboard-wrapper">

                    <!-- ============================================================
                         ADD-ON HEADER
                         ============================================================ -->
                    <div class="aioa_dashboard-addon-header">
                      <div class="d-flex align-items-center gap-3">
                        <a t-att-href="skynet_vs_back_url" class="btn addon-btn-back" id="backToAdminLink" title="Back to Admin">
                          <span class="material-symbols-outlined">arrow_back</span>
                        </a>
                        <h2 class="aioa_dashboard-addon-header-title mb-0" tabindex="-1">SkynetAccessibility Video Subtitle</h2>
                      </div>

                      <div class="aioa_dashboard-addon-header-actions">
                        <span class="addon-price">
                          <span class="addon-price-amount" id="planPrice">$0</span><span
                            class="addon-price-interval">/<span id="planInterval">Month</span></span>
                        </span>

                        <span class="addon-status" id="planStatus">Active</span>

                        <!-- Revealed only if get-start returns an autologin link (adon_link).
                             Starts hidden so nothing dead is shown when it doesn't. -->
                        <a class="btn addon-btn-howto d-none" id="manageAccountLink"
                           href="#" target="_blank" rel="noopener noreferrer">
                          <span class="material-symbols-outlined">open_in_new</span>
                          Manage Account
                        </a>

                        <button type="button" class="btn addon-btn-upgrade" id="upgradePlanBtn">Upgrade Plan</button>

                        <button type="button" class="btn addon-btn-howto" id="howToUseBtn">
                          <span class="material-symbols-outlined">help</span>
                          How to Use
                        </button>
                      </div>
                    </div>

                    <!-- ============================================================
                         QUOTA LIMIT ALERT
                         ============================================================ -->
                    <div class="row mb-4 d-none" id="quotaAlertRow">
                      <div class="col-12">
                        <div class="alert alert-danger mb-0 d-flex align-items-center gap-3" style="border-radius:12px">
                          <span class="material-symbols-outlined" style="font-size:24px;color:#E74C3C">warning</span>
                          <div>
                            <h6 class="alert-heading fs-6 mb-1">Quota Limit Reached</h6>
                            <p class="mb-0">You have reached your quota limit. Please upgrade your plan to continue.</p>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- ============================================================
                         STAT CARDS
                         ============================================================ -->
                    <div class="row g-3 mb-3" id="statCardsRow">
                      <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 h-100 stat-card">
                          <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                            <div class="stat-icon-wrapper">
                              <span class="material-symbols-outlined">smart_display</span>
                            </div>
                            <div>
                              <div class="fw-medium stat-label">Videos Remediated</div>
                              <div class="d-flex align-items-baseline gap-1">
                                <span class="fw-bold stat-value" id="statRemediated">0</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 h-100 stat-card">
                          <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                            <div class="stat-icon-wrapper">
                              <span class="material-symbols-outlined">schedule</span>
                            </div>
                            <div>
                              <div class="fw-medium stat-label">Total Time Limit</div>
                              <div class="d-flex align-items-baseline gap-1">
                                <span class="fw-bold stat-value" id="statTotalMin">0</span>
                                <span class="fw-bold stat-unit">Minutes</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 h-100 stat-card">
                          <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                            <div class="stat-icon-wrapper">
                              <span class="material-symbols-outlined">hourglass_top</span>
                            </div>
                            <div>
                              <div class="fw-medium stat-label">Spent Duration</div>
                              <div class="d-flex align-items-baseline gap-1">
                                <span class="fw-bold stat-value" id="statUsedMin">0:00</span>
                                <span class="fw-bold stat-unit">Minutes</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 h-100 stat-card">
                          <div class="card-body d-flex align-items-center gap-3 py-4 px-4">
                            <div class="stat-icon-wrapper">
                              <span class="material-symbols-outlined">note_alt</span>
                            </div>
                            <div>
                              <div class="fw-medium stat-label">Remaining Duration</div>
                              <div class="d-flex align-items-baseline gap-1">
                                <span class="fw-bold stat-value" id="statRemainMin">0:00</span>
                                <span class="fw-bold stat-unit">Minutes</span>
                              </div>
                              <div class="mt-1 d-none" id="lowQuotaHint">
                                <small class="text-danger">
                                  <span class="material-symbols-outlined" style="font-size:14px;vertical-align:-2px">error</span>
                                  Low remaining quota
                                </small>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- ============================================================
                         MAIN PANEL
                         ============================================================ -->
                    <div class="aioa_dashboard-pdf-remediation">

                      <!--   Site blocked notice   -->
                      <div class="p-4 pb-0 d-none" id="scanBlockedBox">
                        <div class="video-scraping-progress rounded p-3" style="background-color:#fff3f3;border:1px solid #f5c6cb">
                          <div class="d-flex align-items-center gap-2">
                            <i class="material-symbols-outlined" style="font-size:35px;color:#dc3545">block</i>
                            <div>
                              <div class="fw-bold" style="font-size:1.1rem">We couldn't access this site.</div>
                              <div class="text-muted">
                                It appears to be blocked. Please whitelist IP "74.124.193.166" and try again.
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!--   Scan progress   -->
                      <div class="video-scraping-progress rounded d-none" id="scanProgressBox">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                          <div class="d-flex align-items-center gap-2">
                            <i class="material-symbols-outlined" style="font-size:35px;color:#420083">travel_explore</i>
                            <span class="fw-medium">Scanning website for videos&#8230;</span>
                          </div>
                          <span class="text-muted small" id="scanPercentLabel">0%</span>
                        </div>
                        <div class="progress" style="height:10px;border-radius:999px">
                          <div class="progress-bar progress-bar-striped progress-bar-animated" id="scanProgressBar"
                            role="progressbar" style="width:0%;background-color:#420083;border-radius:999px"
                            aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-2">
                          <small class="fs-6" id="scanProgressText">Preparing scan&#8230;</small>
                          <small class="text-muted">This may take a few moments.</small>
                        </div>
                      </div>

                      <!--   Add-by-URL / Scan-more cards   -->
                      <div class="aioa_dashboard-pdf-remediation-filter-wrapper pb-0" id="topCardsWrapper">
                        <div class="row g-3 mb-3" id="topCardsRow">

                          <!-- Manual URL card -->
                          <div class="col-12 d-none" id="manualUrlCol">
                            <div class="card border-0 h-100 manual-add-block" style="border-radius:14px;background:#F1EEFF">
                              <div class="card-body p-3 p-md-4">
                                <div class="d-flex align-items-start gap-3">
                                  <div class="icon-tile icon-tile-white flex-shrink-0">
                                    <span class="material-symbols-outlined" style="color:#420083;font-size:24px">link</span>
                                  </div>
                                  <div class="flex-grow-1 min-w-0">
                                    <div class="mb-3">
                                      <h6 class="fw-bold mb-1" style="font-size:15px">Add a Video by URL</h6>
                                      <p class="mb-0 text-muted" style="font-size:13px;line-height:1.5">
                                        Have a specific video page in mind? Paste its URL below and we'll queue it for remediation.
                                      </p>
                                    </div>
                                    <div>
                                      <label for="manualUrlInput" class="form-label fw-semibold mb-2" style="font-size:13px">
                                        Video URL
                                      </label>
                                      <div class="d-flex flex-column flex-sm-row gap-2">
                                        <div class="flex-grow-1">
                                          <input type="text" class="form-control" id="manualUrlInput"
                                            placeholder="e.g. https://example.com/videos/intro" style="border-radius:8px" />
                                          <div class="invalid-feedback" id="manualUrlError"></div>
                                          <div class="text-muted mt-1" id="manualUrlHelp" style="font-size:11px">
                                            Enter the complete URL of the page containing the video.
                                          </div>
                                        </div>
                                        <button type="button" class="btn btn-primary flex-shrink-0 d-flex align-items-center justify-content-center gap-1"
                                          id="addManualUrlBtn" disabled="disabled"
                                          style="height:42px;min-width:110px;border-radius:8px;font-size:13px;font-weight:600">
                                          <span class="material-symbols-outlined" style="font-size:18px">add</span>
                                          <span>Add URL</span>
                                        </button>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>

                          <!-- Scan-for-more card -->
                          <div class="col-12 d-none" id="scanMoreCol">
                            <div class="card border-0 h-100" style="border-radius:14px;border:1px dashed #ECEAF7">
                              <div class="card-body p-3 p-md-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                                <div class="d-flex align-items-start gap-3">
                                  <div class="icon-tile icon-tile-light flex-shrink-0">
                                    <span class="material-symbols-outlined" style="color:#420083;font-size:24px">travel_explore</span>
                                  </div>
                                  <div>
                                    <h6 class="fw-bold mb-1">Scan for More Videos</h6>
                                    <p class="text-muted mb-0" style="font-size:13px">
                                      This batch is complete. Run another scan to process the next 50 URLs and find additional
                                      videos on your site.
                                    </p>
                                  </div>
                                </div>
                                <button type="button" class="btn btn-primary flex-shrink-0 d-flex align-items-center justify-content-center gap-1"
                                  id="openScanModalBtn" style="border-radius:8px;white-space:nowrap">
                                  <span class="material-symbols-outlined" style="font-size:18px">search</span>
                                  <span id="scanMoreBtnLabel">Find Video</span>
                                </button>
                              </div>
                            </div>
                          </div>

                        </div>
                      </div>

                      <!--   Tabs + filters   -->
                      <div class="aioa_dashboard-pdf-remediation-filter-wrapper">
                        <div class="aioa_dashboard-video-remediation-type-list-tab">
                          <ul role="tablist">
                            <li>
                              <button type="button" class="btn btn-primary btn-sm active" data-tab="0" role="tab" aria-selected="true">
                                Website Scan Video (<span id="tabCount0">0</span>)
                              </button>
                            </li>
                            <li>
                              <button type="button" class="btn btn-primary btn-sm" data-tab="1" role="tab" aria-selected="false">
                                Remediated Video (<span id="tabCount1">0</span>)
                              </button>
                            </li>
                            <li>
                              <button type="button" class="btn btn-primary btn-sm" data-tab="2" role="tab" aria-selected="false">
                                Failed Video (<span id="tabCount2">0</span>)
                              </button>
                            </li>
                          </ul>
                        </div>

                        <div class="aioa_dashboard-pdf-remediation-filter-block-wrapper">
                          <div class="aioa_dashboard-pdf-remediation-filter-block caption-text">
                            <h5 class="mb-0" id="listCaption">Select Video URL to Request Remediation services</h5>
                          </div>

                          <div class="aioa_dashboard-pdf-remediation-filter-block-list">
                            <div class="aioa_dashboard-pdf-remediation-filter-block" id="decorativeFilterBlock">
                              <label class="form-label" for="decorative_filter">Video Type</label>
                              <select class="form-select" id="decorative_filter" aria-label="Decorative">
                                <option value="all">All</option>
                                <option value="1">Decorative Only</option>
                                <option value="0">Non-Decorative Only</option>
                              </select>
                            </div>

                            <div class="aioa_dashboard-pdf-remediation-filter-block" id="statusFilterBlock">
                              <label class="form-label" for="pdf_type">Status</label>
                              <select class="form-select" id="pdf_type" aria-label="Status">
                                <option value="all">All Videos</option>
                                <option value="0">Pending</option>
                                <option value="1">Processing</option>
                                <option value="3">Remediated</option>
                                <option value="4">Failed</option>
                              </select>
                            </div>

                            <div class="aioa_dashboard-pdf-remediation-filter-block">
                              <label class="form-label" for="showPages">Items Per Page</label>
                              <select class="form-select" id="showPages" aria-label="Items Per Page">
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="40">40</option>
                                <option value="50">50</option>
                                <option value="80">80</option>
                                <option value="100">100</option>
                              </select>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!--   Table   -->
                      <div class="aioa_dashboard-table table-responsive">
                        <div class="aioa_dashboard-table-thead">
                          <div class="aioa_dashboard-table-tr">
                            <div class="aioa_dashboard-table-th tcw-50 aioa_dashboard-table-cell-sidegap" id="thSelectAll">
                              <div class="form-check p-0 m-0" data-bs-toggle="tooltip" data-bs-placement="right" title="Select All">
                                <input class="form-check-input" type="checkbox" id="selectAllCheckbox" aria-label="Select all Videos" />
                              </div>
                            </div>
                            <div class="aioa_dashboard-table-th tcw-100 aioa_dashboard-table-cell-sidegap text-center">Sr No</div>
                            <div class="aioa_dashboard-table-th tcw-auto aioa_dashboard-table-cell-sidegap">Video URL</div>
                            <div class="aioa_dashboard-table-th tcw-150 aioa_dashboard-table-cell-sidegap text-center">Duration</div>
                            <div class="aioa_dashboard-table-th tcw-150 aioa_dashboard-table-cell-sidegap text-center" id="thDecorative">
                              Decorative Video
                            </div>
                            <div class="aioa_dashboard-table-th tcw-50 aioa_dashboard-table-cell-sidegap text-center">Pages</div>
                            <div class="aioa_dashboard-table-th tcw-200 text-center aioa_dashboard-table-cell-sidegap">
                              <span class="d-inline-flex align-items-center gap-1">
                                Status
                                <i class="material-symbols-outlined status-legend-trigger" id="statusLegendBtn"
                                  style="font-size:1.2rem;cursor:pointer;color:#6c757d" role="button" tabindex="0"
                                  aria-label="Status information">info</i>
                              </span>
                            </div>
                          </div>
                        </div>

                        <div class="aioa_dashboard-table-body" id="tableBody" aria-live="polite"></div>

                        <!-- Sticky selection footer -->
                        <div class="position-sticky bottom-0 bg-light p-2 px-5 d-none" id="selectionFooter" style="z-index:9">
                          <div class="alert alert-danger text-white text-center d-none" id="prePurchaseAlert"></div>
                          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <span class="me-3" id="selectionSummary"></span>
                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap d-none" id="selectionActions">
                              <div class="form-check form-switch d-flex align-items-center justify-content-center gap-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="multi-lang-switch" />
                                <label class="form-check-label" for="multi-lang-switch">Multi Language</label>
                              </div>
                              <button type="button" class="btn btn-primary btn-lg mb-0 ms-3 d-flex align-items-center"
                                id="remediateSelectedBtn">
                                <span class="material-symbols-outlined me-2" style="font-size:20px">auto_awesome</span>
                                Add Selected for Remediation
                              </button>
                            </div>
                          </div>
                          <div class="text-danger mt-2 text-center d-none" id="estimatedPricingMsg">
                            <strong>Some selected videos have unknown duration &#8212; final pricing is an estimate.</strong>
                          </div>
                        </div>

                        <!-- Pagination -->
                        <div class="aioa_dashboard-table-pagination-main d-flex flex-wrap align-items-center justify-content-between gap-3">
                          <div class="aioa_dashboard-showrecord-item" id="showRecordItem"></div>
                          <nav aria-label="Pagination">
                            <ul class="pagination justify-content-center align-items-center flex-wrap mb-0" id="paginationList"></ul>
                          </nav>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       MODAL: Scan options
                       ============================================================ -->
                  <div class="modal fade video-remediation-modal" id="scanModal" tabindex="-1" aria-labelledby="scanModalTitle"
                    aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header border-0 pb-0 d-flex align-items-start justify-content-between">
                          <div class="d-flex gap-3">
                            <div class="icon-tile icon-tile-light flex-shrink-0" style="width:48px;height:48px">
                              <span class="material-symbols-outlined" style="color:#420083;font-size:34px">video_search</span>
                            </div>
                            <div>
                              <h5 class="modal-title fw-bold" id="scanModalTitle" style="font-size:22px">Scan for More Videos</h5>
                              <p class="text-muted mb-0 mt-1" style="font-size:14px">
                                Your current batch of 50 URLs has been completed.<br />What would you like to do next?
                              </p>
                            </div>
                          </div>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body pt-4">
                          <!-- Option: next batch -->
                          <div class="scan-option selected" role="button" tabindex="0" data-scan-mode="0">
                            <div class="d-flex align-items-start gap-3">
                              <div class="form-check mt-2">
                                <input class="form-check-input" type="radio" name="scanModeOption" id="scanModeBatch" checked="checked"
                                  aria-label="Scan Another Batch" />
                              </div>
                              <div class="icon-tile icon-tile-white flex-shrink-0">
                                <span class="material-symbols-outlined" style="color:#420083;font-size:26px">layers</span>
                              </div>
                              <div>
                                <div class="fw-bold" style="color:#420083">Scan Another 50 URLs</div>
                                <div class="text-muted" style="font-size:13px">
                                  Continue scanning the next batch of 50 URLs to look for additional videos.
                                </div>
                              </div>
                            </div>
                            <span class="badge rounded-pill scan-recommended-badge flex-shrink-0">
                              <span class="material-symbols-outlined" style="font-size:14px">star</span> Recommended
                            </span>
                          </div>

                          <!-- Option: full scan -->
                          <div class="scan-option" role="button" tabindex="0" data-scan-mode="1">
                            <div class="d-flex align-items-start gap-3">
                              <div class="form-check mt-2">
                                <input class="form-check-input" type="radio" name="scanModeOption" id="scanModeFull"
                                  aria-label="Perform Full Scan" />
                              </div>
                              <div class="icon-tile icon-tile-white flex-shrink-0">
                                <span class="material-symbols-outlined" style="color:#20223B;font-size:26px">public</span>
                              </div>
                              <div>
                                <div class="fw-bold" style="color:#20223B">Perform Full Scan</div>
                                <div class="text-muted" style="font-size:13px">Scan all remaining URLs on your website.</div>
                              </div>
                            </div>
                          </div>

                          <!-- Full scan warning -->
                          <div class="full-scan-warning d-none" id="fullScanWarning">
                            <div class="d-flex align-items-start gap-3">
                              <div class="warning-ring flex-shrink-0">
                                <span class="material-symbols-outlined" style="color:#F39C12;font-size:20px">priority_high</span>
                              </div>
                              <div>
                                <div class="fw-bold mb-1">Full Scan May Take Several Hours</div>
                                <div style="font-size:14px">
                                  You have a total of <strong style="color:#420083"><span id="remainingUrlCount">0</span> URLs</strong>
                                  to scan.
                                </div>
                                <div style="font-size:14px">
                                  Running a full scan may take
                                  <strong style="color:#F39C12">several minutes to several hours</strong> to complete.
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-2 p-2 warning-tip">
                                  <span class="material-symbols-outlined" style="color:#F39C12;font-size:18px">lightbulb</span>
                                  <span style="font-size:13px">
                                    <strong>Tip:</strong> For faster results, we recommend scanning your website in batches of 50 URLs.
                                  </span>
                                </div>
                              </div>
                            </div>
                            <div class="flex-shrink-0 d-none d-md-block">
                              <span class="material-symbols-outlined" style="color:#F39C12;font-size:56px;opacity:.85">schedule</span>
                            </div>
                          </div>
                        </div>

                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal" id="scanCancelBtn">Cancel</button>
                          <button type="button" class="btn btn-primary" id="scanConfirmBtn">Confirm</button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       MODAL: Video pages
                       ============================================================ -->
                  <div class="modal fade" id="pagesModal" tabindex="-1" aria-labelledby="pagesModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="pagesModalTitle">Video Pages</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="pagesModalBody"></div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       MODAL: Decorative confirm
                       ============================================================ -->
                  <div class="modal fade" id="decorativeConfirmModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title">Change Video Status</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">Are you sure you want to change this status?</div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="decorativeCancelBtn">Cancel</button>
                          <button type="button" class="btn btn-primary" id="decorativeConfirmBtn">Yes, Confirm</button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       MODAL: Status info
                       ============================================================ -->
                  <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="statusModalTitle"></h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="statusModalBody"></div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       MODAL: How to Use
                       ============================================================ -->
                  <div class="modal fade" id="howToUseModal" tabindex="-1" aria-labelledby="howToUseTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="howToUseTitle">How to Use Video Subtitle</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <ol class="howto-list">
                            <li>Add the provided <strong>subtitle script</strong> to your website.</li>
                            <li>Allow the system to scan your website and automatically discover all
                              <strong>supported videos</strong>.</li>
                            <li><strong>Decorative videos</strong> are detected automatically and marked as
                              decorative by default. You can change this at any time using the toggle.</li>
                            <li>Select the videos you want to remediate, then choose whether you want
                              <strong>Single Language</strong> or <strong>Multiple Languages</strong> subtitles.</li>
                            <li>Wait for remediation to complete.</li>
                            <li>Open any remediated video on your website and play it. Subtitles will be displayed
                              automatically in your website's <strong>default language</strong>.</li>
                          </ol>

                          <div class="howto-note">
                            <strong>Note:</strong>
                            <ul>
                              <li><strong>Multi-language subtitles</strong> are not available with the standalone
                                Video Subtitle plan. To enable multilingual subtitles, you must also purchase the
                                <strong>All in One Accessibility Widget</strong>.</li>
                              <li><strong>Duplicate videos</strong> are detected automatically and do not require
                                separate remediation.</li>
                              <li>Supported video players: <strong>YouTube</strong>,
                                <strong>Native HTML5 Player</strong>, and <strong>Video.js</strong>. Support for
                                additional players is coming soon.</li>
                            </ul>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       MODAL: Upgrade plan (PlanSelectionModal)
                       ============================================================ -->
                  <div class="modal fade" id="planModal" tabindex="-1" aria-labelledby="planModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="planModalTitle">Upgrade Plan</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <div class="aioa_dashboard-addon-details aioa_dashboard-settings-with-preview-wrapper">
                            <div class="aioa_dashboard-addon-plan-radio-list mt-0" id="planList"></div>

                            <div class="aioa_dashboard-plan-radio-footer d-flex flex-column align-items-center mt-4" id="planFooter">
                              <div class="aioa_dashboard-plan-radio-error text-danger mb-2 d-none" role="alert" id="planError"></div>
                              <button type="button" class="btn btn-primary btn-lg" id="planSubmitBtn" disabled="disabled">Select Plan</button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- ============================================================
                       TOASTS
                       ============================================================ -->
                  <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" style="z-index:1200"></div>

                  <script
                    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                    crossorigin="anonymous"></script>
                  <!-- Hidden values consumed by vs-dashboard-api.js, filled in server-side
                       from this module's own ir.config_parameter rows (Settings >
                       SkynetAccessibility Video Subtitle > Configuration) and from the
                       logged-in Settings user - same values Phase 1's dashboard already
                       used. Read into window.SkynetVideoSubtitleConfig by the inline
                       script below, which must run before vs-dashboard-api.js so that
                       file's SITE_ORIGIN/PLATFORM/name/email overrides are in place when
                       it evaluates. -->
                  <input type="hidden" id="savs_api_base" t-att-value="skynet_vs_api_base"/>
                  <input type="hidden" id="savs_platform" t-att-value="skynet_vs_platform"/>
                  <p id="savs_username" style="display:none;" t-esc="skynet_vs_username"/>
                  <p id="savs_useremail" style="display:none;" t-esc="skynet_vs_useremail"/>

                  <script>
                    (function () {
                      var apiBase = document.getElementById('savs_api_base').value || '';
                      window.SkynetVideoSubtitleConfig = {
                        // vs-dashboard-api.js appends /api/website-video etc itself, so
                        // strip a trailing "/api" or "/api/" from the configured base.
                        siteOrigin: apiBase.replace(/\/api\/?$/, ''),
                        platform: document.getElementById('savs_platform').value || 'Odoo',
                        userName: (document.getElementById('savs_username').textContent || '').trim(),
                        userEmail: (document.getElementById('savs_useremail').textContent || '').trim()
                      };
                    })();
                  </script>

                  <script src="/odoo_skynetaccessibility_video_subtitle/static/src/js/vs-dashboard-api.js"></script>
                  <script src="/odoo_skynetaccessibility_video_subtitle/static/src/js/vs-dashboard-app.js"></script>
                </body>
                </html>
            </t>
        </field>
    </record>

    <record id="website_page_skynet_vs_dashboard" model="website.page">
        <field name="url">/skynet-video-subtitle-dashboard</field>
        <field name="view_id" ref="view_skynet_vs_dashboard_page"/>
        <field name="is_published">True</field>
        <field name="website_indexed">False</field>
    </record>

    <record id="action_skynet_vs_dashboard_url" model="ir.actions.act_url">
        <field name="name">SkynetAccessibility Video Subtitle</field>
        <field name="url">/skynet-video-subtitle-dashboard</field>
        <field name="target">self</field>
    </record>

</odoo>
